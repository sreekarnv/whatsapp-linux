{
  "name": "whatsapp-linux",
  "version": "0.1.1",
  "description": "Unofficial Chromium-based WhatsApp Web wrapper for Linux",
  "homepage": "https://github.com/sreekarnv/whatsapp-linux",
  "author": {
    "name": "Sreekar Nutulapati",
    "email": "sreekarnv1@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p electron/tsconfig.json && electron dist-electron/main.js",
    "build": "tsc -p electron/tsconfig.json",
    "dist": "pnpm build && electron-builder --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3"
  },
  "build": {
    "appId": "com.sreekarnv.whatsapp-linux",
    "productName": "WhatsApp Linux",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icons/icon.png",
      "maintainer": "Sreekar Nutulapati <sreekarnv1@gmail.com>",
      "synopsis": "Unofficial WhatsApp Web wrapper for Linux",
      "description": "A Chromium-based Electron desktop wrapper for the official WhatsApp Web site."
    },
    "protocols": [
      {
        "name": "WhatsApp Linux Deep Link",
        "schemes": [
          "whatsapp-linux"
        ]
      }
    ]
  },
  "packageManager": "pnpm@11.21.0"
}
